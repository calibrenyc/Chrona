{
  "name": "chrona-game-launcher",
  "version": "1.3.9",
  "description": "Chrona, a local-first game launcher for Steam, Epic, Xbox, Ubisoft, and portable installs.",
  "author": "Calibre",
  "chronaUpdates": {
    "repository": "calibrenyc/Chrona"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item Env:ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue; & './node_modules/.bin/electron.cmd' .\"",
    "dist": "electron-builder --win nsis portable zip --x64",
    "dist:signed": "node scripts/signed-build.cjs",
    "audit": "node scripts/audit-renderer.cjs"
  },
  "build": {
    "appId": "com.calibre.chrona",
    "productName": "Chrona",
    "artifactName": "Chrona-Update-${version}-win-${arch}.${ext}",
    "afterPack": "scripts/package-manifest.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Chrona ${version}.exe"
    },
    "nsis": {
      "artifactName": "ChronaSetup-${version}.exe",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false
    },
    "asarUnpack": [
      "src/vendor/7zip/**"
    ]
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "semver": "^7.8.5"
  }
}
